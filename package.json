{
  "name": "valleys",
  "description": "A lightweight TypeScript library for validating runtime wire data.",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimeshnayaju/valleys.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm lint:package",
    "prepack": "pnpm build",
    "lint:package": "pnpm build && publint --strict"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
