{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "printWidth": 120,
  "experimentalSortPackageJson": false,
  "ignorePatterns": ["dist/**", "pnpm-lock.yaml"],
  "jsdoc": {
    "commentLineStrategy": "multiline",
    "capitalizeDescriptions": true,
    "descriptionWithDot": true
  }
}
